{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "#kit/*": ["../../packages/kit/src/*"],
      "#ex/*": ["../../packages/excalidraw/src/*"],
      "@excalidraw/excalidraw/*": ["../../packages/excalidraw/src/core/*"]
    }
  },
  "include": ["src"]
}

{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "m3",
  "title": "M3 init",
  "description": "shadcn init for a Solid + Tailwind CSS 4 app: writes components.json, adds cn and the M3 theme. Skips the default React style.",
  "registryDependencies": ["bieniucieniu/solidx/utils", "bieniucieniu/solidx/m3-theme"],
  "type": "registry:base",
  "config": {
    "style": "base",
    "rsc": false,
    "tsx": true,
    "tailwind": {
      "config": "",
      "css": "src/index.css",
      "baseColor": "neutral",
      "cssVariables": true,
      "prefix": ""
    },
    "aliases": {
      "components": "@/components",
      "utils": "@/lib/utils",
      "ui": "@/components/ui",
      "lib": "@/lib",
      "hooks": "@/hooks"
    }
  }
}

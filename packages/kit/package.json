{
  "name": "@solid-kit/kit",
  "version": "0.0.1",
  "private": true,
  "description": "Solid 2.0 rewrite of the solid-kit packages: ui and m3 on @ui-sdk/solid, plus motion, xyflow, and tiptap.",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#kit/*": "./src/*"
  },
  "exports": {
    "./ui": {
      "types": "./src/components/ui/index.ts",
      "import": "./src/components/ui/index.ts",
      "default": "./src/components/ui/index.ts"
    },
    "./ui/theme.css": "./src/components/ui/theme.css",
    "./m3": {
      "types": "./src/components/m3/index.ts",
      "import": "./src/components/m3/index.ts",
      "default": "./src/components/m3/index.ts"
    },
    "./m3/theme.css": "./src/components/m3/theme.css",
    "./m3/tokens.css": "./src/components/m3/tokens.css",
    "./motion": {
      "types": "./src/components/motion/index.ts",
      "import": "./src/components/motion/index.ts",
      "default": "./src/components/motion/index.ts"
    },
    "./xyflow": {
      "types": "./src/components/xyflow/index.ts",
      "import": "./src/components/xyflow/index.ts",
      "default": "./src/components/xyflow/index.ts"
    },
    "./xyflow/panels": {
      "types": "./src/components/xyflow/panels.ts",
      "import": "./src/components/xyflow/panels.ts",
      "default": "./src/components/xyflow/panels.ts"
    },
    "./xyflow/style.css": "./src/components/xyflow/style.css",
    "./tiptap": {
      "types": "./src/components/tiptap/index.ts",
      "import": "./src/components/tiptap/index.ts",
      "default": "./src/components/tiptap/index.ts"
    },
    "./tiptap/menus": {
      "types": "./src/components/tiptap/menus/index.ts",
      "import": "./src/components/tiptap/menus/index.ts",
      "default": "./src/components/tiptap/menus/index.ts"
    },
    "./tiptap/node-view": {
      "types": "./src/components/tiptap/node-view.ts",
      "import": "./src/components/tiptap/node-view.ts",
      "default": "./src/components/tiptap/node-view.ts"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@shikijs/core": "^4.6.0",
    "@shikijs/engine-javascript": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/solid": "0.1.0-beta.13",
    "@xyflow/system": "1.0.0",
    "clsx": "^2.1.1",
    "fast-equals": "^6.4.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "^2.0.3",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-bubble-menu": "^3.35.0",
    "@tiptap/extension-floating-menu": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@vitest/browser-playwright": "catalog:",
    "motion": "^14.14.0",
    "playwright": "^1.65.1",
    "solid-js": "^2.0.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.3",
    "@tiptap/core": "^3.23.5",
    "@tiptap/extension-bubble-menu": "^3.23.5",
    "@tiptap/extension-floating-menu": "^3.23.5",
    "@tiptap/pm": "^3.23.5",
    "motion": "^14.9.0",
    "solid-js": "^2.0.3"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-bubble-menu": {
      "optional": true
    },
    "@tiptap/extension-floating-menu": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "motion": {
      "optional": true
    }
  }
}

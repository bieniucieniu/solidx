{
  "name": "@solidx/excalidraw",
  "version": "0.0.1",
  "private": true,
  "description": "Headless Excalidraw editor for Solid 2.0, ported from @excalidraw/excalidraw.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/core/polyfill.ts"
  ],
  "imports": {
    "#ex/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "test": "vp test",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@braintree/sanitize-url": "6.0.2",
    "@excalidraw/common": "0.18.0-2c3dcc0",
    "@excalidraw/element": "0.18.0-2c3dcc0",
    "@excalidraw/laser-pointer": "1.3.1",
    "@excalidraw/math": "0.18.0-2c3dcc0",
    "browser-fs-access": "0.38.0",
    "canvas-roundrect-polyfill": "0.0.1",
    "es6-promise-pool": "2.5.0",
    "fuzzy": "0.1.3",
    "image-blob-reduce": "3.0.1",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "nanoid": "3.3.3",
    "pako": "2.0.3",
    "perfect-freehand": "1.2.0",
    "pica": "7.1.1",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "points-on-curve": "1.0.1",
    "roughjs": "4.6.4"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "^2.0.3",
    "@types/lodash.debounce": "4.0.8",
    "@types/lodash.throttle": "4.1.7",
    "@types/pako": "2.0.3",
    "@types/pica": "5.1.3",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "^1.65.1",
    "solid-js": "^2.0.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3"
  }
}

{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "isolatedModules": true,
    "paths": {
      "#ex/*": ["./src/*"],
      "@excalidraw/excalidraw": ["./src/core/index.ts"],
      "@excalidraw/excalidraw/*": ["./src/core/*"]
    }
  },
  "include": ["src"]
}
